# Supabase — Project Settings > API.
# Sem estas variáveis o app funciona em modo ilustrativo (o painel não grava execuções).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Secret key (sb_secret_...) ou a service_role legada. Só é lida no servidor;
# nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=
